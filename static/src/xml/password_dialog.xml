<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="cdfi_invoice.PasswordDialog" owl="1">
    <!-- Nota las comillas simples dentro de las dobles: "'Texto'" -->
    <Dialog title="'Confirmar acción'">
      <div class="mb-2">Ingrese su contraseña para romper la conciliación:</div>
      <input type="password" 
             class="form-control" 
             t-model="state.password" 
             placeholder="Contraseña"
             t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; confirm()"/>
      
      <t t-set-slot="footer">
        <button type="button" class="btn btn-primary" t-on-click="confirm">Confirmar</button>
        <button type="button" class="btn btn-secondary" t-on-click="props.close">Cancelar</button>
      </t>
    </Dialog>
  </t>
</templates>