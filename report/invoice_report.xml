<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_cfdi_mhk" model="report.paperformat">
        <field name="name">CFDI MHK</field>
        <field name="default" eval="True"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         LAYOUT EXTERNO: solo maneja header de cancelada y footer
    ═══════════════════════════════════════════════════════════ -->
    <template id="cfdi_external_layout">
        <t t-if="not o and doc"><t t-set="o" t-value="doc"/></t>
        <t t-if="o and 'company_id' in o"><t t-set="company" t-value="o.company_id"/></t>
        <t t-if="not o or 'company_id' not in o"><t t-set="company" t-value="res_company"/></t>

        <div class="header" style="min-height:1px;">
            <t t-if="o.estado_factura == 'factura_cancelada'">
                <div style="text-align:center;color:red;font-weight:bold;border:2px solid red;padding:3px 8px;margin-bottom:4px;font-size:13pt;">
                    ✕ COMPROBANTE CANCELADO ✕
                </div>
            </t>
        </div>

        <div class="article o_report_layout_standard"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id">
            <t t-raw="0"/>
        </div>

        <div class="footer" style="font-size:8pt;border-top:1px solid #bbb;padding-top:3px;text-align:center;color:#555;">
            <span t-if="company.phone">Tel: <span t-field="company.phone"/>&#160;&#160;</span>
            <span t-if="company.email">| Email: <span t-field="company.email"/>&#160;&#160;</span>
            <span t-if="company.website">| <span t-field="company.website"/></span>
            <div t-if="company.report_footer"><span t-field="company.report_footer"/></div>
            <div>Página <span class="page"/> / <span class="topage"/></div>
        </div>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         DOCUMENTO PRINCIPAL: CFDI-MHK
    ═══════════════════════════════════════════════════════════ -->
    <template id="report_invoice_document">
        <t t-call="cdfi_invoice.cfdi_external_layout">
            <t t-set="o" t-value="o.with_context({'lang': o.partner_id.lang})"/>

            <div class="page" style="font-size:9.5pt;font-family:Arial,sans-serif;">

                <!-- ── MARCA DE AGUA PRUEBA ── -->
                <t t-if="o.company_id.modo_prueba">
                    <div style="position:fixed;top:40%;left:10%;opacity:0.08;z-index:99;transform:rotate(-30deg);pointer-events:none;">
                        <span style="font-size:100px;color:red;font-weight:bold;">PRUEBA</span>
                    </div>
                </t>

                <!-- ══════════════════════════════════════════════
                     ENCABEZADO: Logo | Emisor | Datos documento
                ══════════════════════════════════════════════ -->
                <table style="width:100%;border-collapse:collapse;border:1.5px solid #222;margin-bottom:5px;">
                    <tr>
                        <!-- LOGO -->
                        <td style="width:18%;border-right:1px solid #aaa;padding:8px;text-align:center;vertical-align:middle;">
                            <img t-if="o.company_id.logo"
                                 t-att-src="image_data_uri(o.company_id.logo)"
                                 style="max-height:90px;max-width:110px;"/>
                        </td>

                        <!-- EMISOR -->
                        <td style="width:48%;border-right:1px solid #aaa;padding:8px;vertical-align:top;">
                            <div style="font-size:8pt;color:#555;font-weight:bold;margin-bottom:2px;">EMISOR</div>
                            <div style="font-size:11pt;font-weight:bold;margin-bottom:3px;">
                                <t t-if="o.factura_cfdi">
                                    <span t-field="o.company_id.nombre_fiscal"/>
                                </t>
                                <t t-else="">
                                    <span t-field="o.company_id.partner_id.name"/>
                                </t>
                            </div>
                            <t t-if="o.factura_cfdi">
                                <div>RFC: <strong><span t-field="o.company_id.vat"/></strong></div>
                                <div>
                                    Régimen fiscal:
                                    <span t-field="o.company_id.regimen_fiscal_id.code"/> -
                                    <span t-field="o.company_id.regimen_fiscal_id.description"/>
                                </div>
                            </t>
                            <div>
                                <span t-field="o.company_id.partner_id.street"/>
                                <t t-if="o.company_id.partner_id.city">,
                                    <span t-field="o.company_id.partner_id.city"/>
                                </t>
                                <t t-if="o.company_id.partner_id.state_id">,
                                    <span t-field="o.company_id.partner_id.state_id"/>
                                </t>
                                <t t-if="o.company_id.partner_id.zip">
                                    C.P. <span t-field="o.company_id.partner_id.zip"/>
                                </t>
                            </div>
                        </td>

                        <!-- DATOS DEL DOCUMENTO -->
                        <td style="width:34%;padding:0;vertical-align:top;">
                            <!-- Tipo de documento (barra de título) -->
                            <div style="background:#222;color:#fff;text-align:center;font-size:12pt;font-weight:bold;padding:5px;">
                                <t t-if="o.factura_cfdi and o.move_type == 'out_invoice'">FACTURA</t>
                                <t t-elif="o.move_type == 'out_refund'">NOTA DE CRÉDITO</t>
                                <t t-elif="o.move_type == 'in_invoice'">FACTURA DE PROVEEDOR</t>
                                <t t-elif="not o.factura_cfdi and o.move_type == 'out_invoice'">NOTA DE VENTA</t>
                                <t t-else="">COMPROBANTE</t>
                            </div>
                            <div style="padding:8px;">
                                <table style="width:100%;font-size:9pt;">
                                    <tr>
                                        <td style="color:#555;width:45%;">Folio:</td>
                                        <td style="font-weight:bold;">
                                            <t t-if="o.serie_emisor">
                                                <span t-field="o.serie_emisor"/>-</t>
                                            <span t-field="o.number_folio"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="color:#555;">Fecha:</td>
                                        <td>
                                            <t t-if="o.factura_cfdi">
                                                <span t-esc="str(o.fecha_factura).replace('T',' ') if o.fecha_factura else ''"/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="o.invoice_date"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="color:#555;">Lugar expedición:</td>
                                        <td><span t-field="o.company_id.partner_id.zip"/></td>
                                    </tr>
                                    <t t-if="o.factura_cfdi">
                                        <tr>
                                            <td style="color:#555;">Tipo comprobante:</td>
                                            <td><span t-field="o.tipo_comprobante"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="o.tipocambio and o.tipocambio != '1'">
                                        <tr>
                                            <td style="color:#555;">Tipo de cambio:</td>
                                            <td><span t-field="o.tipocambio"/></td>
                                        </tr>
                                        <tr>
                                            <td style="color:#555;">Moneda:</td>
                                            <td><span t-field="o.moneda"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- ══════════════════════════════════════════════
                     RECEPTOR
                ══════════════════════════════════════════════ -->
                <table style="width:100%;border-collapse:collapse;border:1.5px solid #222;margin-bottom:5px;">
                    <tr>
                        <td colspan="4" style="background:#222;color:#fff;padding:3px 8px;font-weight:bold;font-size:8.5pt;">
                            RECEPTOR
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:4px 8px;width:25%;color:#555;font-size:8.5pt;">Nombre:</td>
                        <td style="padding:4px 8px;width:40%;font-weight:bold;">
                            <span t-field="o.partner_id.name"/>
                        </td>
                        <t t-if="o.factura_cfdi">
                            <td style="padding:4px 8px;width:15%;color:#555;font-size:8.5pt;">RFC:</td>
                            <td style="padding:4px 8px;font-weight:bold;">
                                <span t-field="o.partner_id.rfc"/>
                            </td>
                        </t>
                    </tr>
                    <t t-if="o.factura_cfdi">
                        <tr>
                            <td style="padding:4px 8px;color:#555;font-size:8.5pt;">Uso CFDI:</td>
                            <td style="padding:4px 8px;">
                                <span t-field="o.uso_cfdi_id.code"/> -
                                <span t-field="o.uso_cfdi_id.description"/>
                            </td>
                            <td style="padding:4px 8px;color:#555;font-size:8.5pt;">Domicilio:</td>
                            <td style="padding:4px 8px;font-size:8.5pt;">
                                <span t-field="o.partner_id.street"/>
                                <t t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></t>
                                <t t-if="o.partner_id.zip"> C.P.<span t-field="o.partner_id.zip"/></t>
                            </td>
                        </tr>
                    </t>
                </table>

                <!-- ══════════════════════════════════════════════
                     CONCEPTOS
                ══════════════════════════════════════════════ -->
                <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>
                <t t-set="amount_untaxed" t-value="0.0"/>
                <t t-set="amount_total" t-value="0.0"/>

                <table style="width:100%;border-collapse:collapse;margin-bottom:5px;font-size:8.5pt;">
                    <thead>
                        <tr style="background:#222;color:#fff;">
                            <th style="padding:4px 5px;border:1px solid #444;text-align:center;width:8%;">Clave SAT</th>
                            <th style="padding:4px 5px;border:1px solid #444;text-align:center;width:7%;">Cantidad</th>
                            <th style="padding:4px 5px;border:1px solid #444;width:10%;">Unidad</th>
                            <th style="padding:4px 5px;border:1px solid #444;width:28%;">Descripción</th>
                            <th style="padding:4px 5px;border:1px solid #444;text-align:right;width:10%;">P. Unitario</th>
                            <t t-if="display_discount">
                                <th style="padding:4px 5px;border:1px solid #444;text-align:right;width:8%;">Descuento</th>
                            </t>
                            <th style="padding:4px 5px;border:1px solid #444;text-align:right;width:9%;">Importe</th>
                            <th style="padding:4px 5px;border:1px solid #444;text-align:center;width:8%;">Impuesto</th>
                            <th style="padding:4px 5px;border:1px solid #444;text-align:center;width:6%;">Factor</th>
                            <th style="padding:4px 5px;border:1px solid #444;text-align:right;width:6%;">Tasa</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids" t-as="l">
                            <t t-if="not l.display_type and l.quantity > 0">
                                <t t-set="price" t-value="l.price_unit * (1 - (l.discount or 0.0) / 100.0)"/>
                                <t t-set="amounts" t-value="l.tax_ids.compute_all(price, l.currency_id, l.quantity, product=l.product_id, partner=l.move_id.partner_id)"/>
                                <t t-set="price_net" t-value="l.move_id.currency_id.round(amounts['total_excluded'])"/>
                                <t t-set="taxes_detail" t-value="amounts['taxes']"/>
                                <t t-set="amount_untaxed" t-value="amount_untaxed + price_net"/>
                                <t t-set="amount_total" t-value="amount_total + l.move_id.currency_id.round(amounts['total_included'])"/>
                                <tr style="border-bottom:1px solid #e0e0e0;">
                                    <td style="padding:3px 5px;border:1px solid #ddd;text-align:center;">
                                        <span t-field="l.product_id.clave_producto"/>
                                    </td>
                                    <td style="padding:3px 5px;border:1px solid #ddd;text-align:center;">
                                        <span t-field="l.quantity"/>
                                    </td>
                                    <td style="padding:3px 5px;border:1px solid #ddd;font-size:7.5pt;">
                                        <span t-field="l.product_id.cat_unidad_medida.clave"/>
                                        <span t-field="l.product_id.cat_unidad_medida.descripcion"/>
                                    </td>
                                    <td style="padding:3px 5px;border:1px solid #ddd;">
                                        <span t-field="l.name"/>
                                    </td>
                                    <td style="padding:3px 5px;border:1px solid #ddd;text-align:right;">
                                        <span t-field="l.price_unit"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </td>
                                    <t t-if="display_discount">
                                        <td style="padding:3px 5px;border:1px solid #ddd;text-align:right;">
                                            <span t-esc="l.price_unit * ((l.discount or 0.0)/100.0) * l.quantity"
                                                  t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                        </td>
                                    </t>
                                    <td style="padding:3px 5px;border:1px solid #ddd;text-align:right;">
                                        <span t-esc="price_net"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </td>
                                    <!-- Impuestos por línea -->
                                    <td style="padding:3px 5px;border:1px solid #ddd;text-align:center;font-size:7.5pt;">
                                        <t t-foreach="l.tax_ids" t-as="tax">
                                            <div><span t-field="tax.impuesto"/></div>
                                        </t>
                                    </td>
                                    <td style="padding:3px 5px;border:1px solid #ddd;text-align:center;font-size:7.5pt;">
                                        <t t-foreach="l.tax_ids" t-as="tax">
                                            <div><span t-field="tax.tipo_factor"/></div>
                                        </t>
                                    </td>
                                    <td style="padding:3px 5px;border:1px solid #ddd;text-align:right;font-size:7.5pt;">
                                        <t t-foreach="l.tax_ids" t-as="tax">
                                            <div><span t-esc="abs(tax.amount)"/>%</div>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                            <!-- Líneas de nota/sección -->
                            <t t-elif="l.display_type">
                                <tr>
                                    <td colspan="10" style="padding:3px 5px;font-style:italic;color:#555;font-size:8pt;">
                                        <span t-field="l.name"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <!-- ══════════════════════════════════════════════
                     TOTALES + IMPORTE EN LETRA + CFDI RELACIONADO
                ══════════════════════════════════════════════ -->
                <table style="width:100%;border-collapse:collapse;margin-bottom:5px;">
                    <tr style="vertical-align:top;">
                        <!-- Columna izquierda: importe en letra + CFDI relacionado -->
                        <td style="width:58%;padding-right:8px;">
                            <div style="border:1px solid #aaa;padding:5px 8px;font-size:8.5pt;margin-bottom:4px;">
                                <strong>Son: <span t-esc="o._get_amount_2_text(o.amount_total)"/></strong>
                            </div>
                            <t t-if="o.tipo_relacion">
                                <div style="border:1px solid #aaa;padding:5px 8px;font-size:8.5pt;">
                                    <div style="font-weight:bold;margin-bottom:3px;">CFDI RELACIONADO</div>
                                    <div>Tipo de relación: <span t-field="o.tipo_relacion"/></div>
                                    <div style="word-break:break-all;">UUID: <span t-field="o.uuid_relacionado"/></div>
                                </div>
                            </t>
                        </td>
                        <!-- Columna derecha: tabla de totales -->
                        <td style="width:42%;">
                            <table style="width:100%;border-collapse:collapse;font-size:9pt;">
                                <tr style="border-bottom:1px solid #ccc;">
                                    <td style="padding:3px 8px;">Subtotal</td>
                                    <td style="padding:3px 8px;text-align:right;">
                                        <span t-esc="amount_untaxed"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-foreach="(o.tax_totals or {}).get('groups_by_subtotal', {}).values()" t-as="tax_groups">
                                    <t t-foreach="tax_groups" t-as="tax_group">
                                        <tr style="border-bottom:1px solid #ccc;">
                                            <td style="padding:3px 8px;">
                                                <span t-esc="tax_group['tax_group_name']"/>
                                            </td>
                                            <td style="padding:3px 8px;text-align:right;">
                                                <span t-esc="tax_group['formatted_tax_group_amount']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <tr style="background:#222;color:#fff;">
                                    <td style="padding:4px 8px;font-weight:bold;">TOTAL</td>
                                    <td style="padding:4px 8px;text-align:right;font-weight:bold;">
                                        <span t-esc="o.amount_total"
                                              t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- ══════════════════════════════════════════════
                     DATOS FISCALES DEL CFDI
                ══════════════════════════════════════════════ -->
                <t t-if="o.factura_cfdi">
                    <table style="width:100%;border-collapse:collapse;border:1.5px solid #222;margin-bottom:5px;font-size:8.5pt;">
                        <tr>
                            <td colspan="4" style="background:#222;color:#fff;padding:3px 8px;font-weight:bold;">
                                DATOS FISCALES DEL COMPROBANTE
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:3px 8px;color:#555;width:18%;border:1px solid #e0e0e0;">Método de pago</td>
                            <td style="padding:3px 8px;width:32%;border:1px solid #e0e0e0;">
                                <span t-field="o.methodo_pago"/>
                            </td>
                            <td style="padding:3px 8px;color:#555;width:18%;border:1px solid #e0e0e0;">Núm. Certificado</td>
                            <td style="padding:3px 8px;border:1px solid #e0e0e0;">
                                <span t-field="o.numero_cetificado"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:3px 8px;color:#555;border:1px solid #e0e0e0;">Forma de pago</td>
                            <td style="padding:3px 8px;border:1px solid #e0e0e0;">
                                <span t-field="o.forma_pago_id.code"/> -
                                <span t-field="o.forma_pago_id.description"/>
                            </td>
                            <td style="padding:3px 8px;color:#555;border:1px solid #e0e0e0;">Certificado SAT</td>
                            <td style="padding:3px 8px;border:1px solid #e0e0e0;font-size:7pt;word-break:break-all;">
                                <span t-field="o.cetificaso_sat"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:3px 8px;color:#555;border:1px solid #e0e0e0;">Moneda</td>
                            <td style="padding:3px 8px;border:1px solid #e0e0e0;">
                                <span t-field="o.moneda"/>
                            </td>
                            <td style="padding:3px 8px;color:#555;border:1px solid #e0e0e0;">Folio Fiscal (UUID)</td>
                            <td style="padding:3px 8px;border:1px solid #e0e0e0;font-size:8pt;">
                                <span t-field="o.folio_fiscal"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:3px 8px;color:#555;border:1px solid #e0e0e0;">Tipo de cambio</td>
                            <td style="padding:3px 8px;border:1px solid #e0e0e0;">
                                <span t-field="o.tipocambio"/>
                            </td>
                            <td style="padding:3px 8px;color:#555;border:1px solid #e0e0e0;">Fecha certificación</td>
                            <td style="padding:3px 8px;border:1px solid #e0e0e0;">
                                <span t-field="o.fecha_certificacion"/>
                            </td>
                        </tr>
                    </table>
                </t>

                <!-- ══════════════════════════════════════════════
                     SELLOS Y QR
                ══════════════════════════════════════════════ -->
                <div name="cadenas" style="border:1.5px solid #222;padding:6px;page-break-inside:avoid;margin-bottom:5px;">
                    <table style="width:100%;border-collapse:collapse;">
                        <tr style="vertical-align:top;">
                            <td style="width:18%;text-align:center;padding-right:6px;border-right:1px solid #ccc;">
                                <img t-if="o.qrcode_image"
                                     t-att-src="image_data_uri(o.qrcode_image)"
                                     style="height:140px;width:140px;"/>
                            </td>
                            <td style="padding-left:8px;font-size:7pt;word-break:break-all;line-height:1.3;">
                                <div style="margin-bottom:4px;">
                                    <strong>Cadena Original del Complemento Digital del SAT</strong><br/>
                                    <span t-field="o.cadena_origenal"/>
                                </div>
                                <div style="margin-bottom:4px;">
                                    <strong>Sello Digital del CFDI</strong><br/>
                                    <span t-field="o.selo_digital_cdfi"/>
                                </div>
                                <div>
                                    <strong>Sello del SAT</strong><br/>
                                    <span t-field="o.selo_sat"/>
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- ══════════════════════════════════════════════
                     OBSERVACIONES
                ══════════════════════════════════════════════ -->
                <t t-if="o.narration">
                    <div style="border:1px solid #ccc;padding:5px 8px;font-size:8.5pt;margin-bottom:5px;">
                        <strong>Observaciones: </strong><span t-field="o.narration"/>
                    </div>
                </t>

                <!-- ══════════════════════════════════════════════
                     LEYENDA LEGAL
                ══════════════════════════════════════════════ -->
                <div style="text-align:center;font-size:8pt;font-weight:bold;padding:4px;border-top:1px solid #ccc;margin-top:4px;">
                    ESTE DOCUMENTO ES UNA REPRESENTACIÓN IMPRESA DE UN CFDI
                </div>

            </div>
        </t>
    </template>

    <!-- ══════════════════════════════════════════════
         CONTENEDOR HTML Y ACCIÓN DEL REPORTE
    ══════════════════════════════════════════════ -->
    <template id="account.report_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="cdfi_invoice.report_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <report id="account.account_invoices"
            model="account.move"
            string="CFDI-MHK"
            report_type="qweb-pdf"
            name="account.report_invoice"
            file="cdfi_invoice.report_invoice"
            paperformat="cdfi_invoice.paperformat_cfdi_mhk"/>

</odoo>
