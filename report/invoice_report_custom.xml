<odoo>
  <!-- Inherit invoice report (from module accounting) -->
  <template id="report_invoice_inherit_cdfi" inherit_id="account.report_invoice_document">
        <!--EMPTY HEADER SO THE NAME IS IN THE TOP-->

        <xpath expr="//div[@id='informations']" position="after">
            <t t-if="o.company_id.modo_prueba == True">
                <div style="position:absolute;opacity:0.25;z-index:1000;width:100%;">
                    <center><span style="font-size:100px;color:red;">FACTURA DE PRUEBA</span></center>
                </div>
            </t>

            <t t-if="o.estado_factura == 'factura_cancelada'">
                <div style="position:absolute;opacity:0.25;z-index:1000;width:100%;">
                    <center><span style="font-size:100px;color:red;">CANCELADO</span></center>
                </div>
            </t>
        </xpath>

        <!-- Recuadros Emisor / Receptor en primera hoja -->
        <xpath expr="//div[@id='informations']" position="before">
            <t t-if="o.factura_cfdi">
                <div class="row mb-3">
                    <div class="col-6" style="padding-right:5px;">
                        <div style="border:1px solid #adb5bd;border-radius:4px;overflow:hidden;height:100%;">
                            <div style="font-size:11px;font-weight:bold;text-align:center;background-color:#f1f3f4;padding:5px 8px;border-bottom:1px solid #adb5bd;">
                                DATOS DEL EMISOR
                            </div>
                            <table style="font-size:10px;width:100%;border-collapse:collapse;margin:0;">
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;width:40%;white-space:nowrap;">Nombre:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.company_id.nombre_fiscal"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">RFC:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.company_id.vat"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Régimen fiscal:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.company_id.regimen_fiscal_id.code"/> - <span t-field="o.company_id.regimen_fiscal_id.description"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Lugar expedición:</td>
                                    <td style="padding:3px 8px 3px 0;">
                                        <t t-if="o.journal_id.codigo_postal"><span t-field="o.journal_id.codigo_postal"/></t>
                                        <t t-if="not o.journal_id.codigo_postal"><span t-field="o.company_id.partner_id.zip"/></t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-6" style="padding-left:5px;">
                        <div style="border:1px solid #adb5bd;border-radius:4px;overflow:hidden;height:100%;">
                            <div style="font-size:11px;font-weight:bold;text-align:center;background-color:#f1f3f4;padding:5px 8px;border-bottom:1px solid #adb5bd;">
                                DATOS DEL RECEPTOR
                            </div>
                            <table style="font-size:10px;width:100%;border-collapse:collapse;margin:0;">
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;width:40%;white-space:nowrap;">Nombre:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">RFC:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.vat"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Régimen fiscal:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.regimen_fiscal_id.code"/> - <span t-field="o.partner_id.regimen_fiscal_id.description"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Uso CFDI:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.uso_cfdi_id.code"/> - <span t-field="o.uso_cfdi_id.description"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
            <t t-elif="o.journal_id.code == 'NOT'">
                <div class="row mb-3">
                    <div class="offset-col-6 col-6" style="padding-left:5px;">
                        <div style="border:1px solid #adb5bd;border-radius:4px;overflow:hidden;">
                            <div style="font-size:11px;font-weight:bold;text-align:center;background-color:#f1f3f4;padding:5px 8px;border-bottom:1px solid #adb5bd;">
                                DATOS DEL CLIENTE
                            </div>
                            <table style="font-size:10px;width:100%;border-collapse:collapse;margin:0;">
                                <tr t-if="o.partner_id.parent_id">
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;width:35%;white-space:nowrap;">Empresa:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.parent_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;width:35%;white-space:nowrap;">Nombre:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.name"/></td>
                                </tr>
                                <tr t-if="o.partner_id.street">
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Calle:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.street"/><t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t></td>
                                </tr>
                                <tr t-if="o.partner_id.zip or o.partner_id.city">
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">C.P. / Ciudad:</td>
                                    <td style="padding:3px 8px 3px 0;">
                                        <t t-if="o.partner_id.zip"><span t-field="o.partner_id.zip"/><t t-if="o.partner_id.city">, </t></t>
                                        <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/></t>
                                    </td>
                                </tr>
                                <tr t-if="o.partner_id.state_id">
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Estado:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.state_id.name"/></td>
                                </tr>
                                <tr t-if="o.partner_id.phone">
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Teléfono:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.phone"/></td>
                                </tr>
                                <tr t-if="o.partner_id.mobile">
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Celular:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.mobile"/></td>
                                </tr>
                                <tr t-if="o.partner_id.email">
                                    <td style="font-weight:bold;padding:3px 4px 3px 8px;vertical-align:top;white-space:nowrap;">Correo:</td>
                                    <td style="padding:3px 8px 3px 0;"><span t-field="o.partner_id.email"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

        <!-- Ocultar dirección receptor estándar en facturas CFDI y Nota de Venta (los recuadros ya la muestran) -->
        <xpath expr="//div[@name='no_shipping']" position="replace">
            <div class="offset-col-6 col-6" name="no_shipping" t-if="not o.factura_cfdi and o.journal_id.code != 'NOT'">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" id="partner_vat_no_shipping">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                    </div>
                    <p name="fiscal_regime" t-if="o.partner_id.regimen_fiscal_id">
                        Regimen fiscal: <span t-field="o.partner_id.regimen_fiscal_id.code"/> - <span t-field="o.partner_id.regimen_fiscal_id.description"/>
                    </p>
                </t>
            </div>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']" position="replace">
            <div class="offset-col-6 col-6" name="address_same_as_shipping" t-if="not o.factura_cfdi and o.journal_id.code != 'NOT'">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                    </div>
                    <p name="fiscal_regime" t-if="o.partner_id.regimen_fiscal_id">
                        Regimen fiscal: <span t-field="o.partner_id.regimen_fiscal_id.code"/> - <span t-field="o.partner_id.regimen_fiscal_id.description"/>
                    </p>
                </t>
            </div>
        </xpath>
        <xpath expr="//div[@name='address_not_same_as_shipping']" position="replace">
            <div class="col-6" name="address_not_same_as_shipping" t-if="not o.factura_cfdi and o.journal_id.code != 'NOT'">
                <t t-set="address">
                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                    <div t-if="o.partner_id.vat" id="partner_vat_address_not_same_as_shipping">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                    </div>
                    <p name="fiscal_regime" t-if="o.partner_id.regimen_fiscal_id">
                        Regimen fiscal: <span t-field="o.partner_id.regimen_fiscal_id.code"/> - <span t-field="o.partner_id.regimen_fiscal_id.description"/>
                    </p>
                </t>
            </div>
        </xpath>

        <!-- Título del PDF: "Nota de Venta" cuando el diario tiene código NOT -->
        <xpath expr="//div[hasclass('page')]/h2" position="replace">
            <h2>
                <t t-if="o.journal_id.code == 'NOT'">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Nota de Venta</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Nota de Venta (Borrador)</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Nota de Venta (Cancelada)</span>
                </t>
                <t t-else="">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                    <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                    <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                    <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                </t>
                <span t-if="o.name != '/'" t-field="o.name"/>
            </h2>
        </xpath>

        <xpath expr="//div[@name='customer_code']" position="after">
            <t t-if="o.factura_cfdi">
                <t t-set="original_o_grid_layout" t-value="o_grid_layout"/>
                <t t-set="o_grid_layout" t-value="'col-auto col-3 mw-100 mb-2'"/>

                <div t-att-class="o_grid_layout">
                    <strong>Uso:</strong>
                    <p class="m-0" t-field="o.uso_cfdi_id.code"/> - <span t-field="o.uso_cfdi_id.description"/>
                </div>

                <div t-att-class="o_grid_layout" t-if="o.forma_pago_id">
                    <strong>Forma de pago:</strong>
                    <p class="m-0" t-field="o.forma_pago_id.code"/> - <span t-field="o.forma_pago_id.description"/>
                </div>

                <div t-att-class="o_grid_layout" t-if="o.methodo_pago">
                    <strong>Método de pago:</strong>
                    <p class="m-0" t-field="o.methodo_pago"/>
                </div>

                <t t-set="o_grid_layout" t-value="original_o_grid_layout"/>
            </t>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[1]" position="before">
            <th t-if="o.factura_cfdi">
                <span>Clave Producto</span>
            </th>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']/tbody//tr[1]//td[1]" position="before">
            <td t-if="o.factura_cfdi"><span t-field="line.product_id.clave_producto"/></td>
        </xpath>

        <!-- INFORMACION PRODUCTOS -->
        <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[4]" position="after">
            <th t-if="o.factura_cfdi" class="text-end">
                <span>Unidad SAT</span>
            </th>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']/tbody//tr[1]//td[4]" position="after">
            <td t-if="o.factura_cfdi" class="text-end"><span t-field="line.product_id.cat_unidad_medida.clave" /> - 
                <span t-field="line.product_id.cat_unidad_medida.descripcion" /></td>
        </xpath>

    <xpath expr="//div[@class='clearfix mb-4']" position="after">
        <t t-if="o.factura_cfdi">
            <div class="col-xs-5 text-left">
                <div style="color: black;">
                    <strong><span t-esc="o._get_amount_2_text(o.amount_total)" /></strong>
                </div>
            </div>
        </t>
    </xpath>

    <xpath expr="//div[@name='comment']" position="after">
        <t t-if="o.factura_cfdi">
                <t t-if="o.tipo_relacion">
                    <div class="row">
                        <div>
                            <strong>CFDI Relacionado</strong> <br/>
                            Tipo de Relación: <span t-field="o.tipo_relacion"/> | 
                            CFDI Relacionado: <span t-field="o.uuid_relacionado"/>
                        </div>
                    </div>                        
                </t>

                <div class="col-12" style="font-size:10px;">
                    <!--
                    <div>
                        <span><strong>Datos del Emisor</strong></span>
                    </div>
                    <div class="digital-stamp-content">
                        <span>Nombre emisor:</span> <span t-field="o.company_id.nombre_fiscal"/>
                        <span> | RFC Emisor:</span> <span t-field="o.company_id.vat"/>
                        <span> | Regimen fiscal:</span> <span t-field="o.company_id.regimen_fiscal_id.code"/> - <span t-field="o.company_id.regimen_fiscal_id.description"/>
                        <span> | Lugar de expedición::</span> 
                                <t t-if="o.journal_id.codigo_postal">
                                    <span t-field="o.journal_id.codigo_postal"/>
                                </t>
                                <t t-if="not o.journal_id.codigo_postal">
                                    <span t-field="o.company_id.partner_id.zip"/>
                                </t>
                    </div>
                    -->
                    <div>
                        <span><strong>Información Adicional</strong></span>
                    </div>
                    <div>
                        <span>Fecha y hora de certificación:</span> <span t-field="o.fecha_certificacion" />
                        <span> | Número de certificado:</span> <span t-field="o.numero_cetificado" />
                        <span> | Moneda:</span> <span t-field="o.moneda" />
                        <span> | Certificado SAT:</span><span t-field="o.cetificaso_sat" />
                        <span> | Tipo de cambio:</span> <span t-field="o.tipocambio" />
                        <span> | Folio fiscal:</span> <span t-field="o.folio_fiscal" />
                    </div>

                    <t t-if="o.factura_global">
                       <div>
                           <span><strong>Factura global</strong></span>
                       </div>
                       <div>
                           <span>Periodicidad:</span> <span t-field="o.fg_periodicidad" />
                           <span> | Mes:</span> <span t-field="o.fg_meses" />
                           <span> | Año:</span> <span t-field="o.fg_ano" />
                       </div>
                    </t>

                </div>

           <br/>

           <div name="cadenas" class="row" style="page-break-inside: avoid">
                    <div class="barcode col-3">
                         <img t-if="o.qrcode_image" t-att-src="image_data_uri(o.qrcode_image)" style="height: 180px;width: 180px;" />
                    </div>

                    <div class="col-9" style="font-size:10px;">
                         <!--CADENA ORIGINAL> -->
                         <strong>Cadena Original del Complemento digital del SAT</strong><br/>
                         <span t-field="o.cadena_origenal" style="font-size:8px;"/><br/>

                         <strong>Sello digital del CFDI</strong><br/>
                         <span t-field="o.selo_digital_cdfi" style="font-size:8px;"/><br/>

                         <strong>Sello del SAT</strong><br/>
                         <span t-field="o.selo_sat" style="font-size:8px;"/><br/>
                    </div>
           </div>

           <p>
                <center>
                    <strong>ESTE DOCUMENTO ES UNA REPRESENTACIÓN IMPRESA DE UN CFDI</strong>
                </center>
           </p>
        </t>
    </xpath>


  </template>

  <!-- Nombre del archivo PDF para diario NOT: solo "NOT_2026_XXXXX.pdf" -->
  <record id="account.account_invoices" model="ir.actions.report">
    <field name="print_report_name">(object.journal_id.code == 'NOT' and object.name) or (object.move_type == 'out_invoice' and object.state == 'draft' and 'Draft Invoice - %s' % (object.name,)) or (object.move_type == 'out_invoice' and 'Invoice - %s' % (object.name,)) or (object.move_type == 'out_refund' and 'Credit Note - %s' % (object.name,)) or (object.move_type == 'in_invoice' and 'Vendor Bill - %s' % (object.name,)) or (object.move_type == 'in_refund' and 'Vendor Credit Note - %s' % (object.name,))</field>
  </record>

  <!-- Resetea account.report_invoice para que use account.report_invoice_document
       (que ya tiene las modificaciones CFDI de report_invoice_inherit_cdfi) -->
  <template id="account.report_invoice">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="account.report_invoice_document" t-lang="o.partner_id.lang"/>
      </t>
    </t>
  </template>

</odoo>
