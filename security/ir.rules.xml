<odoo>
    <!--
        REGLA GLOBAL DE VISIBILIDAD DE FACTURAS
        =========================================
        Regla GLOBAL (sin grupos) → se combina con AND sobre todas las demás.
        Odoo ya tiene reglas de grupo para account.move que dan acceso total;
        una regla global sobreescribe ese AND y sí restringe.

        Lógica:
          • Grupo "Ver todas las facturas" → dominio (1=1): ve todo.
          • Otros usuarios internos → solo ven facturas donde son:
              - El creador (create_uid)
              - El vendedor/responsable (invoice_user_id)
              - Seguidor del registro (message_partner_ids):
                cubre cobros, mensajes en el chatter, etc.
    -->
    <record id="rule_invoice_visibilidad_global" model="ir.rule">
        <field name="name">[Facturas] Visibilidad por usuario (regla global)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[(1,'=',1)] if user.has_group('cdfi_invoice.group_view_all_invoices') else ['|','|',('create_uid','=',user.id),('invoice_user_id','=',user.id),('message_partner_ids','in',[user.partner_id.id])]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
