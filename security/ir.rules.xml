<odoo>
    <!--
        REGLA GLOBAL DE VISIBILIDAD DE FACTURAS
        =========================================
        Por qué es una regla GLOBAL (sin grupos asignados):
          - Las reglas POR GRUPO se combinan con OR entre sí. Odoo ya tiene reglas
            para account.group_account_invoice con dominio (1=1), así que cualquier
            regla de grupo que agreguemos queda anulada por OR.
          - Las reglas GLOBALES se combinan con AND sobre el resultado final, por eso
            sí restringen aunque existan otras reglas de grupo que den acceso total.

        Lógica:
          • Usuario en "group_view_all_invoices" → dominio (1=1): ve todo.
          • Cualquier otro usuario interno → solo ve facturas donde:
              - Es el creador (create_uid)
              - Es el vendedor/responsable (invoice_user_id)
    -->
    <record id="rule_invoice_visibilidad_global" model="ir.rule">
        <field name="name">[Facturas] Visibilidad por usuario (regla global)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <!-- Sin <groups> → regla global, se aplica con AND a todos los usuarios -->
        <field name="domain_force">[(1,'=',1)] if user.has_group('cdfi_invoice.group_view_all_invoices') else ['|',('create_uid','=',user.id),('invoice_user_id','=',user.id)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
