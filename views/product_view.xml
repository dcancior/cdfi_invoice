<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="product_template_form_view" model="ir.ui.view">
       <field name="name">product.template.form.inherit</field>
       <field name="model">product.template</field>
       <field name="priority">5</field>
       <field name="inherit_id" ref="product.product_template_form_view"/>
       <field name="arch" type="xml">
           <xpath expr="//sheet" position="before">
               <div class="alert alert-warning mb-0" role="alert"
                    attrs="{'invisible': [('cfdi_advertencia', '=', False)]}">
                   <field name="cfdi_advertencia" nolabel="1" readonly="1"/>
               </div>
           </xpath>
           <xpath expr="//page[@name='sales']" position="after">
               <page string="CFDI" name="datos_sat">
                  <div class="row mt-2">
                      <div class="col-lg-4">
                          <div class="alert alert-info py-2 px-3" role="status">
                              <b><i class="fa fa-magic me-1"/>Se llenan solos</b>
                              <div class="small">
                                  Al capturar el <b>nombre</b> y el <b>tipo de producto</b> se
                                  proponen la Clave producto del SAT, la Unidad SAT y el objeto
                                  de impuesto. Los servicios reciben la unidad
                                  "Unidad de servicio" (E48).
                              </div>
                          </div>
                      </div>
                      <div class="col-lg-4">
                          <div class="alert alert-success py-2 px-3" role="status">
                              <b><i class="fa fa-hand-o-right me-1"/>Lo que usted escriba manda</b>
                              <div class="small">
                                  Puede cambiar cualquiera de estos datos. <b>El valor que capture
                                  a mano es el que se queda</b> y ya no se vuelve a proponer, aunque
                                  después cambie el nombre del producto.
                              </div>
                          </div>
                      </div>
                      <div class="col-lg-4">
                          <div class="alert alert-secondary py-2 px-3" role="status">
                              <b><i class="fa fa-comments-o me-1"/>Queda registrado</b>
                              <div class="small">
                                  Cada cambio en estos tres campos se anota en el historial de
                                  abajo, indicando si lo propuso el sistema o si se capturó a mano.
                              </div>
                          </div>
                      </div>
                  </div>
                  <group col="4">
                     <field name="cat_unidad_medida" />
                     <field name="clave_producto" />
                     <field name="objetoimp" />
                        <field name="product_parts_ids">
                            <tree editable="bottom">
                                <control>
                                    <create string="Agregar línea"/>
                                </control>
                                <field name="product_id"/>
                                <field name="cantidad"/>
                            </tree>
                        </field>
                  </group>
                  <div class="alert alert-light border py-2 px-3 mb-0" role="status">
                      <i class="fa fa-info-circle me-1"/>
                      La <b>Clave producto</b> se toma del catálogo c_ClaveProdServ del SAT según
                      palabras del nombre (menú <b>Facturación &gt; Configuración &gt; Claves SAT
                      por nombre de producto</b>, donde puede agregar sus propias palabras).
                      Verifique que corresponda a lo que factura: la clave definitiva es
                      responsabilidad del emisor del CFDI.
                  </div>
               </page>
           </xpath>
       </field>
   </record>

   <!-- Reglas para sugerir la clave del SAT según el nombre del producto -->
   <record id="cdfi_clave_producto_regla_tree" model="ir.ui.view">
       <field name="name">cdfi.clave.producto.regla.tree</field>
       <field name="model">cdfi.clave.producto.regla</field>
       <field name="arch" type="xml">
           <tree string="Reglas de clave del SAT" editable="bottom">
               <field name="sequence" widget="handle"/>
               <field name="palabra_clave"/>
               <field name="clave_producto"/>
               <field name="descripcion"/>
               <field name="cat_unidad_medida"/>
               <field name="objetoimp"/>
               <field name="tipo_producto"/>
           </tree>
       </field>
   </record>

   <record id="cdfi_clave_producto_regla_search" model="ir.ui.view">
       <field name="name">cdfi.clave.producto.regla.search</field>
       <field name="model">cdfi.clave.producto.regla</field>
       <field name="arch" type="xml">
           <search string="Reglas de clave del SAT">
               <field name="palabra_clave"/>
               <field name="clave_producto"/>
               <field name="descripcion"/>
               <filter name="servicios" string="Servicios" domain="[('tipo_producto','=','service')]"/>
               <filter name="bienes" string="Bienes" domain="[('tipo_producto','=','bien')]"/>
               <filter name="inactivas" string="Archivadas" domain="[('active','=',False)]"/>
           </search>
       </field>
   </record>

   <record id="action_cdfi_clave_producto_regla" model="ir.actions.act_window">
       <field name="name">Claves SAT por nombre de producto</field>
       <field name="res_model">cdfi.clave.producto.regla</field>
       <field name="view_mode">tree</field>
       <field name="help" type="html">
           <p class="o_view_nocontent_smiling_face">Agregue una regla</p>
           <p>
               Cuando el nombre de un producto contiene la palabra clave, se proponen la
               clave del producto (c_ClaveProdServ), la Unidad SAT y el objeto de impuesto.
           </p>
       </field>
   </record>

   <!-- Completar los datos del SAT en productos que ya existían -->
   <record id="action_server_cfdi_completar_productos" model="ir.actions.server">
       <field name="name">Completar datos CFDI faltantes</field>
       <field name="model_id" ref="product.model_product_template"/>
       <field name="binding_model_id" ref="product.model_product_template"/>
       <field name="binding_view_types">list</field>
       <field name="state">code</field>
       <field name="code">action = records.cfdi_completar_datos_faltantes()</field>
   </record>

   <menuitem id="menu_cdfi_clave_producto_regla"
             name="Claves SAT por nombre de producto"
             parent="account.menu_finance_configuration"
             action="action_cdfi_clave_producto_regla"
             sequence="90"/>
</odoo>
