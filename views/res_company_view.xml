<?xml version="1.0"?>
<odoo>
    <data>
        
        <!-- 1. VISTA HEREDADA ORIGINAL (Protegida con el nuevo grupo) --> 
        <record id="Partner_form" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <!-- Agregamos el atributo groups para que solo los de este grupo (y los admin) vean la pestaña en ajustes generales -->
                    <page name="info_cdfi" string="CFDI" groups="cdfi_invoice.group_cfdi_config,base.group_erp_manager">
                            <group cols="4" string="Configuración">
                                <group>
                                    <field name="nombre_fiscal"/>
                                    <field name="serie_factura"/>
                                    <field name="serie_complemento"/>
                                    <field name="regimen_fiscal_id"/>
                                </group>
                                <group>
                                    <field name="proveedor_timbrado"/>
                                    <field name="modo_prueba"/>
                                </group>
                            </group>
                            <group cols="4" string="Certificado Digital">
                                <group>
                                    <field name="archivo_cer"/>
                                    <field name="archivo_key"/>
                                    <field name="contrasena" password="1"/>
                                    <button name="validar_csd" string="Validar CSD" type="object" class="oe_edit_only oe_inline oe_highlight"/>
                                    <button name="borrar_csd" string="Borrar CSD" type="object" class="oe_edit_only oe_inline oe_highlight"/>
                                </group>
                                <group>
                                    <field name="estado_csd" />
                                    <field name="fecha_csd" />
                                    <field name="aviso_csd" />
                                    <button name="borrar_estado" string="Borrar estado" type="object" class="oe_edit_only oe_inline oe_highlight"/>
                                </group>
                            </group>
                            <group cols="4" string="Timbres">
                                <group>
                                    <field name="saldo_timbres"/>
                                    <field name="fecha_timbres"/>
                                    <field name="saldo_alarma"/>
                                    <field name="correo_alarma"/>
                                    <button name="button_dummy" string="Revisar saldo" type="object" class="oe_edit_only oe_inline oe_highlight" style="margin-left: 10px;"/>
                                </group>
                                <group>
                                </group>
                            </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- 2. NUEVA VISTA EXCLUSIVA (Solo muestra los campos de CFDI, sin el resto de la empresa) -->
        <record id="view_company_form_cfdi_only" model="ir.ui.view">
            <field name="name">res.company.form.cfdi.only</field>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <form string="Configuración CFDI" create="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group cols="4" string="Configuración">
                            <group>
                                <field name="nombre_fiscal"/>
                                <field name="serie_factura"/>
                                <field name="serie_complemento"/>
                                <field name="regimen_fiscal_id"/>
                            </group>
                            <group>
                                <field name="proveedor_timbrado"/>
                                <field name="modo_prueba"/>
                            </group>
                        </group>
                        <group cols="4" string="Certificado Digital">
                            <group>
                                <field name="archivo_cer"/>
                                <field name="archivo_key"/>
                                <field name="contrasena" password="1"/>
                                <button name="validar_csd" string="Validar CSD" type="object" class="oe_edit_only oe_inline oe_highlight"/>
                                <button name="borrar_csd" string="Borrar CSD" type="object" class="oe_edit_only oe_inline oe_highlight"/>
                            </group>
                            <group>
                                <field name="estado_csd" />
                                <field name="fecha_csd" />
                                <field name="aviso_csd" />
                                <button name="borrar_estado" string="Borrar estado" type="object" class="oe_edit_only oe_inline oe_highlight"/>
                            </group>
                        </group>
                        <group cols="4" string="Timbres">
                            <group>
                                <field name="saldo_timbres"/>
                                <field name="fecha_timbres"/>
                                <field name="saldo_alarma"/>
                                <field name="correo_alarma"/>
                                <button name="button_dummy" string="Revisar saldo" type="object" class="oe_edit_only oe_inline oe_highlight" style="margin-left: 10px;"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>

                    <!-- AQUÍ VA EL CHATTER: Justo después de cerrar el </sheet> y antes del </form> -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- 3. ACCIÓN DE SERVIDOR (Abre la compañía actual en la vista exclusiva) -->
        <record id="action_open_cfdi_config" model="ir.actions.server">
            <field name="name">Configuración CFDI</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">
                action = {
                    'type': 'ir.actions.act_window',
                    'name': 'Configuración CFDI',
                    'res_model': 'res.company',
                    'view_mode': 'form',
                    'res_id': env.company.id,
                    'views': [(env.ref('cdfi_invoice.view_company_form_cfdi_only').id, 'form')],
                    'target': 'current',
                }
            </field>
        </record>

        <record id="Partner_form_chatter" model="ir.ui.view">
            <field name="name">res.company.form.chatter</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <!-- Esto busca el final del formulario original y pega el chatter -->
                <xpath expr="//sheet" position="after">
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- 4. MENÚ EN FACTURACIÓN (Visible solo para el nuevo grupo) -->
        <menuitem id="menu_cfdi_config"
                  name="Configuración CFDI"
                  parent="account.menu_finance_configuration"
                  action="action_open_cfdi_config"
                  groups="cdfi_invoice.group_cfdi_config"
                  sequence="100"/>

    </data>
</odoo>