<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista tree de Facturación -->
    <record id="view_invoice_inherit_tree" model="ir.ui.view">
        <field name="name">account.move.inherit.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">

            <!-- Colores en la fila completa -->
            <tree position="attributes">
                <attribute name="decoration-success">estado_factura == 'factura_correcta'</attribute>
                <attribute name="decoration-danger">estado_factura == 'factura_cancelada'</attribute>
                <attribute name="decoration-warning">estado_factura == 'factura_no_generada'</attribute>
            </tree>

            <!-- Campo Estado CFDI antes de 'state' -->
            <field name="state" position="before">
                <field name="estado_factura" string="Estado CFDI" widget="badge"
                    decoration-success="estado_factura == 'factura_correcta'"
                    decoration-danger="estado_factura == 'factura_cancelada'"
                    decoration-warning="estado_factura == 'factura_no_generada'"/>
            </field>
        </field>
    </record>

    <!-- Vista form de Facturación -->
    <record id="view_invoice_inherit_form" model="ir.ui.view">
        <field name="name">account.move.inherit.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Aviso de captura. Vive en el formulario, no en el reporte, así
                 que nunca sale impreso en el PDF de la factura. -->
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <details class="cdfi-guia border rounded bg-light mb-2 p-2"
                         attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}">
                    <summary class="d-flex flex-wrap align-items-center"
                             style="cursor:pointer; gap:.35rem;"
                             title="Clic para ver los pasos">
                        <span class="fw-bold me-1">
                            <i class="fa fa-info-circle" role="img" aria-label="Información"/>
                            Cómo se agregan productos:
                        </span>
                        <span class="badge bg-white text-dark border fw-normal" title="Paso 1 — Cancela esta factura. Si ya está timbrada, cancela primero el CFDI.">
                            <i class="fa fa-ban"/> 1. Cancela aquí
                        </span>
                        <i class="fa fa-angle-right text-muted"/>
                        <span class="badge bg-white text-dark border fw-normal" title="Paso 2 — Abre la cotización u orden de venta que le dio origen.">
                            <i class="fa fa-external-link"/> 2. Ve a la orden
                        </span>
                        <i class="fa fa-angle-right text-muted"/>
                        <span class="badge bg-white text-dark border fw-normal" title="Paso 3 — Captura ahí el producto o servicio, con su cantidad y precio.">
                            <i class="fa fa-plus"/> 3. Agrega el concepto
                        </span>
                        <i class="fa fa-angle-right text-muted"/>
                        <span class="badge bg-white text-dark border fw-normal" title="Paso 4 — Confirma la orden para que quede lista para facturar.">
                            <i class="fa fa-check"/> 4. Confirma
                        </span>
                        <i class="fa fa-angle-right text-muted"/>
                        <span class="badge bg-white text-dark border fw-normal" title="Paso 5 — Genera la factura desde la orden. Así el monto siempre coincide.">
                            <i class="fa fa-file-text-o"/> 5. Vuelve a facturar
                        </span>
                        <span class="text-muted ms-1" style="font-size:.85em;">(clic para el detalle)</span>
                    </summary>
                    <div class="mt-2 ps-1">
                        <p class="mb-2">
                            Los conceptos se capturan en la <b>cotización u orden de venta</b>, nunca
                            directo en la factura. Así el monto facturado y el de la orden siempre
                            coinciden, y no quedan diferencias que después nadie sabe explicar.
                        </p>
                        <ol class="mb-2 ps-3">
                            <li><b>Cancela esta factura.</b> Si ya tiene CFDI timbrado, cancélalo
                                primero; el asiento se cancela solo y la orden vuelve a quedar
                                pendiente de facturar.</li>
                            <li><b>Abre la orden de venta</b> que le dio origen.</li>
                            <li><b>Agrega, corrige o quita</b> ahí los conceptos que hagan falta.</li>
                            <li><b>Confirma la orden.</b></li>
                            <li><b>Genera la factura de nuevo</b> desde la orden.</li>
                        </ol>
                        <p class="mb-0 text-muted" style="font-size:.9em;">
                            ¿La factura no viene de una orden, o es un caso excepcional? Un
                            administrador puede desactivar <b>Bloquear edición de líneas</b> en la
                            pestaña CFDI de esta factura.
                        </p>
                    </div>
                </details>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="info_cdfi" string="CFDI">
                    <group cols="4">
                        <group string="Detalles de Pago">
                            <field name="methodo_pago" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="forma_pago_id" context="{'prioritize_usage': 1}" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="uso_cfdi_id" context="{'prioritize_usage': 1}" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="exportacion" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                        </group>
                        <group string="Detalles de Factura">
                            <field name="tipo_comprobante" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="folio_fiscal"/>
                            <field name="confirmacion" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                            <!-- Badge de estado (form) -->
                            <field name="estado_factura" widget="badge"/>
                            <field name="fecha_factura" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="proceso_timbrado"/>
                            <field name="lock_invoice_lines" groups="base.group_system,cdfi_invoice.group_allow_unlock_invoices"/>
                        </group>
                        <group string="CFDI Relacionados">
                            <field name="tipo_relacion" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="uuid_relacionado" attrs="{'readonly': [('estado_factura','!=','factura_no_generada')]}"/>
                        </group>
                        <group string="Complementos" name="complementos">
                            <field name="factura_global" attrs="{'readonly':[('estado_factura','!=','factura_no_generada')]}"/>
                        </group>
                    </group>
                </page>

                <page name="info_global" string="Factura global" attrs="{'invisible': [('factura_global','=',False)]}">
                    <group cols="4">
                        <group>
                            <field name="fg_periodicidad" attrs="{'readonly':[('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="fg_meses" attrs="{'readonly':[('estado_factura','!=','factura_no_generada')]}"/>
                            <field name="fg_ano" attrs="{'readonly':[('estado_factura','!=','factura_no_generada')]}"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <field name="ref" position="after">
                <field name="factura_cfdi" invisible="1"/>
            </field>

            <button name="action_invoice_sent" position="before">
                <button name="action_invoice_sent" type="object" string="Enviar por correo-e"
                        attrs="{'invisible':[('state', 'not in', ('cancel'))]}" groups="base.group_user"/>
            </button>

            <button name="button_draft" position="before">
                <button name="action_cfdi_generate" type="object" string="Generar CFDI"
                        attrs="{'invisible':['|','|',('state','in',('draft','cancel')),
                                             ('estado_factura','in',('factura_correcta','factura_cancelada','solicitud_rechazada')),
                                             ('move_type','not in',('out_invoice', 'out_refund'))]}"
                        class="oe_highlight" groups="base.group_user"/>

                <button name="%(cdfi_invoice.reason_cancelation_sat_wizard)d" 
                        type="action" string="Cancelar CFDI"
                        attrs="{'invisible':['|',('factura_cfdi','=',False),
                                                  ('estado_factura','in',('solicitud_cancelar', 'factura_cancelada', 'solicitud_rechazada'))]}"
                        class="oe_highlight" groups="base.group_user"/>

                <button name="action_cfdi_rechazada" type="object" string="Cambiar estado CFDI a factura correcta"
                        attrs="{'invisible':['|',('factura_cfdi','=',False),
                                                  ('estado_factura','not in',('solicitud_cancelar', 'solicitud_rechazada'))]}"
                        class="oe_highlight" groups="base.group_user"
                        confirm="La factura va pasar a estado correcto y puede intentar cancelar nuevamente."/>
            </button>
        </field>
    </record>

    <!-- Acción servidor desbloquear CFDI -->
    <record id="model_action_liberar_cfdi" model="ir.actions.server">
        <field name="name">Desbloquear CFDI</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">action = records.liberar_cfdi()</field>
    </record>

    <!-- Wizard mensaje -->
    <record id="mymodule_message_wizard_form" model="ir.ui.view">
        <field name="name">mymodule.message.wizard.form</field>
        <field name="model">mymodule.message.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="message" readonly="True"/>
                <footer>
                    <button name="action_close" string="Ok" type="object" default_focus="1" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="view_sale_order_form_inherit_lock_lines" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.lock.lines</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">

            <!-- Campo técnico (invisible) para evaluar attrs -->
            <xpath expr="//sheet" position="inside">
            <field name="allow_edit_if_inv_cancelled" invisible="1"/>
            </xpath>

            <!-- Controlar readonly del one2many con el flag -->
            <xpath expr="//field[@name='order_line']" position="attributes">
            <attribute name="attrs">
                {
                'readonly': [
                    ('state','in',('sale','done','cancel')),
                    ('allow_edit_if_inv_cancelled','=', False)
                ]
                }
            </attribute>
            <attribute name="editable">bottom</attribute>
            <attribute name="create">true</attribute>
            <attribute name="edit">true</attribute>
            <!-- Si de verdad necesitas limpiar las opciones por defecto, descomenta:
            <attribute name="options"/>
            -->
            </xpath>

        </field>
    </record>

    <!-- 2) (Opcional) Vista — ocultar el botón cuando state = cancel -->
    <record id="view_move_form_inherit_block_reset_cancelled" model="ir.ui.view">
        <field name="name">account.move.form.block.reset.cancelled</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
        <!-- Cubrimos ambos nombres de botón: action_draft / button_draft -->
        <xpath expr="//button[@name='action_draft' or @name='button_draft']" position="attributes">
            <attribute name="attrs">{'invisible': [('state', '=', 'cancel')]}</attribute>
        </xpath>
        </field>
    </record>

    <!-- Solo para que el usuario no vea opciones de agregar/editar/borrar en la tabla  de facturas -->
    <record id="view_move_form_inherit_lock_lines_ui" model="ir.ui.view">
        <field name="name">account.move.form.lock.lines.ui</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
        <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
            <attribute name="options">{'no_create': True, 'no_edit': True, 'no_delete': True, 'no_open': True}</attribute>
            <attribute name="editable"/>
        </xpath>
        </field>
    </record>

</odoo>
